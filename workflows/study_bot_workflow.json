{
  "name": "Study Bot Processing Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "process-study-session",
        "options": {}
      },
      "id": "e6f47702-8618-4221-a477-949f50e930f7",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "webhookId": "process-study-session"
    },
    {
      "parameters": {
        "command": "=\"ffmpeg -y -i \\\"\" + $json.body.video_path + \"\\\" -vn -acodec libmp3lame -q:a 5 \\\"\" + $json.body.video_path + \".mp3\\\"\""
      },
      "id": "c8695013-057b-402a-9289-9edda38072ef",
      "name": "Extract Audio (FFmpeg)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "filePath": "={{ $('Webhook').item.json.body.video_path + \".mp3\" }}"
      },
      "id": "d9812908-1111-4773-8bc1-12a921d23b2c",
      "name": "Read Audio File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/audio/transcriptions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GROQ_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "whisper-large-v3-turbo"
            }
          ]
        },
        "sendBinaryData": true,
        "binaryPropertyName": "file:data",
        "options": {}
      },
      "id": "a1b2c3d4-e5f6-4789-b1c2-d3e4f5a6b7c8",
      "name": "Transcribe via Groq",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=YOUR_GEMINI_API_KEY",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are an expert AI studying assistant. Analyze the following course transcript and extract the requested information in a clean Markdown format.\\n\\nExtract:\\n1. Full Course Summary\\n2. Homework Mentioned\\n3. Tips and Tricks\\n4. Practical Work Changes for next session\\n5. Mention of the student's name ('Mehdi Malik Souhil')\\n6. Estimated Professor Duration/Presence\\n7. YouTube Video Links spoken about\\n\\nTranscript:\\n\" + $json.text\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "b2c3d4e5-f6a7-4890-c2d3-e4f5a6b7c8d9",
      "name": "Extract Data via Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1080,
        300
      ]
    },
    {
      "parameters": {
        "fileName": "={{ $('Webhook').item.json.body.video_path + \"_report.md\" }}",
        "fileContent": "={{ $json.candidates[0].content.parts[0].text }}",
        "options": {}
      },
      "id": "f5e4d3c2-b1a0-4987-a3b2-c1d0e9f8a7b6",
      "name": "Save Markdown Report",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        1300,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Extract Audio (FFmpeg)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Audio (FFmpeg)": {
      "main": [
        [
          {
            "node": "Read Audio File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Audio File": {
      "main": [
        [
          {
            "node": "Transcribe via Groq",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transcribe via Groq": {
      "main": [
        [
          {
            "node": "Extract Data via Gemini",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Data via Gemini": {
      "main": [
        [
          {
            "node": "Save Markdown Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": null,
  "id": "study-bot-workflow-1"
}
